# Vision Detect — Basic edition. Nusxa oling: .env.example -> .env
APP_ENV=development
EDITION=basic
APP_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-64-characters-0123456789abcdef
PUBLIC_API_URL=http://127.0.0.1:8000
DASHBOARD_URL=http://localhost:3000
CORS_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=mysql://root:1234@127.0.0.1:3306/vision_basic
REDIS_URL=

GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-latest
AI_TIMEOUT_SECONDS=15

JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
MAX_IMAGE_MB=5
RATE_LIMIT_SEARCH_PER_MIN_IP=10
RATE_LIMIT_SEARCH_PER_MIN_TENANT=120
DEFAULT_UNMET_THRESHOLD=0.45
ABANDON_AFTER_HOURS=24
ATTRIBUTION_DAYS=7
RUN_WORKER_IN_API=true
